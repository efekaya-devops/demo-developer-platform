# The two GitHub orgs the platform is wired to. This is the single source of
# truth - change it with set-org.sh, which propagates to every repo.
#
#   PLATFORM_ORG - owns the platform itself: idp-gitops, backstage-idp,
#                  terraform-modules, crossplane-modules, platform-docs
#   TEAMS_ORG    - owns what teams asked for: team-alpha, the services the
#                  golden path creates, and the ghcr images they push
#
# To point everything at your own orgs:
#   scripts/set-org.sh <your-platform-org> <your-teams-org>
PLATFORM_ORG=efekaya-devops
TEAMS_ORG=efekaya-devex-platform
